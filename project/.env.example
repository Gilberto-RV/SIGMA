# Copia este archivo como project/.env.local. No subas .env.local a git.

# Backend (incluye /api). En el emulador Android usa http://localhost:5000/api con
#   adb reverse tcp:5000 tcp:5000
# En un teléfono físico usa la IP de tu equipo en la red local, p. ej. http://192.168.1.50:5000/api
EXPO_PUBLIC_API_URL=

# MapTiler (opcional en Android: sin clave o con clave restringida por Referer se usa OpenFreeMap)
EXPO_PUBLIC_MAPTILER_API_KEY=

# Rutas fuera del campus (opcional). Por defecto: OSRM peatonal de FOSSGIS.
# Para un OSRM propio con foot.lua: EXPO_PUBLIC_OSRM_URL=<url> y EXPO_PUBLIC_OSRM_PROFILE=foot
EXPO_PUBLIC_OSRM_URL=
EXPO_PUBLIC_OSRM_PROFILE=
