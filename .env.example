# Variables para docker-compose.yml. Copia este archivo como .env en la raíz del repo.
# (Para ejecutar sin Docker usa backend/.env y backend/ml-service/.env)

MONGO_URI=
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# python -c "import secrets; print(secrets.token_hex(32))"
ML_API_KEY=

# Orígenes permitidos por CORS en el backend (el panel en Docker queda en http://localhost:5173)
CORS_ORIGINS=http://localhost:5173

# Panel Gestory (se incrustan al compilar)
VITE_API_URL=http://localhost:5000/api
VITE_MAPTILER_API_KEY=
