# Copia este archivo como backend/.env y completa los valores. No subas .env a git.

# --- Obligatorias ---
# Cadena de conexión de MongoDB Atlas (o local: mongodb://localhost:27017/sigma)
MONGO_URI=
# Secreto para firmar los JWT. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Servidor ---
PORT=5000
# development | production (en producción no se exponen mensajes internos ni stack)
NODE_ENV=development
# Orígenes permitidos por CORS, separados por comas. Vacío = Gestory y Expo web en localhost.
# Agrega la IP de tu equipo si abres Expo web desde la red local, p. ej. http://192.168.1.89:8081
CORS_ORIGINS=
# Número de proxies delante del backend (Nginx, Render...). Vacío si no hay proxy.
TRUST_PROXY=
# Intentos de login/registro por IP cada 15 minutos
AUTH_RATE_LIMIT=10

# --- Procesamiento y ML ---
ENABLE_BATCH_PROCESSING=true
ML_SERVICE_URL=http://localhost:8000
# Debe coincidir con ML_API_KEY de backend/ml-service/.env
ML_API_KEY=

# --- Solo para `npm run create-admin` ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
