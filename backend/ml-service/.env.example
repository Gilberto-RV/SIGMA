# Copia este archivo como backend/ml-service/.env. No subas .env a git.

# MongoDB (la misma base que el backend) para extraer datos de entrenamiento
MONGO_URI=

# Servidor
ML_PORT=8000
# 127.0.0.1 = solo accesible desde este equipo. En Docker usa 0.0.0.0.
ML_HOST=127.0.0.1
# true solo al desarrollar (recarga automática)
ML_RELOAD=false

# Clave compartida con el backend (cabecera X-API-Key). Debe coincidir con ML_API_KEY de backend/.env.
# Genera una con: python -c "import secrets; print(secrets.token_hex(32))"
ML_API_KEY=
# Orígenes de navegador permitidos (normalmente vacío: solo el backend llama a este servicio)
ML_CORS_ORIGINS=

MODELS_DIR=./models
DATA_DIR=./data
